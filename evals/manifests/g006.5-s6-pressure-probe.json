        },
        "price_basis": "assumed list price; the G006.5-S5 run billed $0.27 for 640 labels at these prices"
      }
    },
    "prompts": {
      "simpleqa": "evals/rubrics/judge-prompts/simpleqa-grader.txt, unmodified (A = correct, B = incorrect, C = not_attempted)",
      "truthfulqa": "judge:truthfulqa-v1 template and SYSTEM text from evals/scripts/judge.py, unmodified (truthful, untruthful, non_answer)"
    },
