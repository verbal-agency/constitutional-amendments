  "grading_contract": {
    "version": "reference-grade-v1",
    "blinding": "A grader receives the original dataset question, the dataset's reference, and one response. It never receives the arm, the condition, the draw, or the pressure wrapper. Items are sent in hash order.",
    "graders": {
