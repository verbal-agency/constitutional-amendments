{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/verbal-agency/constitutional-amendments/schema/x001-mistral-record-v1.json",
  "title": "X001 Mistral principle-derived training record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "example_id",
    "principle_ids",
    "mechanism",
    "boundary",
    "counterexample",
    "interaction_class",
    "messages",
    "desired_behaviors",
    "unacceptable_behaviors",
    "split",
    "provenance",
    "review"
  ],
  "properties": {
    "example_id": {"type": "string", "pattern": "^X001-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "principle_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^P-[A-Za-z0-9._-]+$"}},
    "mechanism": {"type": "string", "minLength": 1},
    "boundary": {"type": "string", "minLength": 1},
    "counterexample": {"type": "string", "minLength": 1},
    "interaction_class": {"type": "string", "minLength": 1},
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"type": "string", "enum": ["system", "user", "assistant"]},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "desired_behaviors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "unacceptable_behaviors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "split": {"type": "string", "enum": ["train", "validation", "heldout"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_id", "source_sha256", "generation_method"],
      "properties": {
        "source_kind": {"type": "string", "enum": ["principle_registry", "human_authored", "human_reviewed_draft"]},
        "source_id": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generation_method": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer_type"],
      "properties": {
        "status": {"type": "string", "enum": ["pending", "approved", "rejected"]},
        "reviewer_type": {"type": "string", "enum": ["human", "human_plus_model", "model_assisted"]},
        "notes": {"type": "string"}
      }
    }
  }
}
