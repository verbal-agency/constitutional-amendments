{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/verbal-agency/constitutional-amendments/schema/x001-mistral-record-v3.json",
  "title": "X001 local Mistral policy-versioned SFT record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "constitution_version",
    "policy_delta_ids",
    "label_method",
    "feedback_model",
    "target_revision",
    "adjudication_status",
    "example_id",
    "family_id",
    "template_id",
    "pair_id",
    "case_role",
    "principle_ids",
    "mechanism",
    "boundary",
    "counterexample",
    "interaction_class",
    "coverage_tags",
    "protected_dimensions",
    "scoring_dimensions",
    "critical_failures",
    "reference_facts",
    "messages",
    "desired_behaviors",
    "unacceptable_behaviors",
    "split",
    "provenance",
    "review"
  ],
  "properties": {
    "record_version": {"const": "x001-record-v3"},
    "constitution_version": {"type": "string", "minLength": 1},
    "policy_delta_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "label_method": {"type": "string", "enum": ["human", "human_plus_model", "model_assisted"]},
    "feedback_model": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "target_revision": {"type": "string", "minLength": 1},
    "adjudication_status": {"type": "string", "enum": ["pending", "approved", "rejected"]},
    "example_id": {"type": "string", "pattern": "^X001-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "family_id": {"type": "string", "pattern": "^XF-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "template_id": {"type": "string", "pattern": "^XT-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "pair_id": {
      "oneOf": [
        {"type": "string", "pattern": "^XP-[A-Za-z0-9][A-Za-z0-9._-]*$"},
        {"type": "null"}
      ]
    },
    "case_role": {
      "type": "string",
      "enum": [
        "positive_application",
        "legitimate_exception",
        "overapplication_trap",
        "counterexample",
        "irrelevant_principle_control",
        "identity_or_persona_swap",
        "uncertainty_or_unknown",
        "disagreement_or_correction",
        "interaction",
        "safety_candor_collision"
      ]
    },
    "principle_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^G006-P0[1-7]$"}
    },
    "mechanism": {"type": "string", "minLength": 1},
    "boundary": {"type": "string", "minLength": 1},
    "counterexample": {"type": "string", "minLength": 1},
    "interaction_class": {
      "type": "string",
      "enum": [
        "none",
        "within_principle_boundary",
        "cross_principle_reinforcing",
        "cross_principle_tension",
        "authority_agency",
        "safety_candor",
        "uncertainty_action",
        "provenance_privacy"
      ]
    },
    "coverage_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "evidence_weighting",
          "updating",
          "disagreement",
          "truthful_limitation",
          "unknown",
          "agency",
          "safety",
          "non_application",
          "identity_invariance",
          "counterfactual_flip",
          "source_provenance",
          "anti_sycophancy"
        ]
      }
    },
    "protected_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["truthfulness", "factuality", "honesty", "safety", "refusal", "agency", "uncertainty", "sycophancy"]
      }
    },
    "scoring_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["ER", "CAL", "CC", "AE", "DS", "UK", "IA", "AP", "SCX", "PS"]}
    },
    "critical_failures": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CF-(0[1-9]|1[0-3])$"}
    },
    "reference_facts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"type": "string", "enum": ["system", "user", "assistant"]},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "desired_behaviors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unacceptable_behaviors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "split": {"type": "string", "enum": ["train", "validation", "heldout"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_id", "source_sha256", "registry_id", "registry_sha256", "generation_method"],
      "properties": {
        "source_kind": {"type": "string", "enum": ["principle_registry", "human_authored", "human_reviewed_draft"]},
        "source_id": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "registry_id": {"const": "g006-principles-v1"},
        "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generation_method": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer_type"],
      "properties": {
        "status": {"type": "string", "enum": ["pending", "approved", "rejected"]},
        "reviewer_type": {"type": "string", "enum": ["human", "human_plus_model", "model_assisted"]},
        "notes": {"type": "string"}
      }
    }
  }
}
